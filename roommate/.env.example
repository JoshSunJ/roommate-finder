# Local PostgreSQL, started with: npm run db:up
DATABASE_URL="postgresql://roommate:roommate_dev_password@localhost:5433/roommate_finder?schema=public"
# Generate a unique value before deploying, for example with: npx auth secret
AUTH_SECRET="replace-with-a-unique-secret-before-production"
ADMIN_EMAIL="admin@example.com"

# Local development stores photos under public/uploads/listings. Production
# must use s3 because server filesystems are not durable across deployments.
PHOTO_STORAGE_DRIVER="local"

# S3-compatible production storage. For Cloudflare R2, use region "auto" and
# an endpoint such as https://<account-id>.r2.cloudflarestorage.com.
S3_BUCKET="roommate-finder-photos"
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public custom domain or bucket URL, without a trailing slash.
PHOTO_PUBLIC_BASE_URL=""
