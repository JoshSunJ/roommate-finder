generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  passwordHash String?
  affiliationType String?
  affiliationName String?
  verificationStatus String @default("unverified")
  verificationSubmittedAt DateTime?
  createdAt DateTime  @default(now())
  listings  Listing[]
  housingRequests HousingRequest[]
  sentInquiries Inquiry[] @relation("InquirySender")
}

model Listing {
  id           Int      @id @default(autoincrement())
  title        String
  rent         Int
  location     String
  description  String
  bedrooms     Int
  bathroomType String
  availableFrom String
  postedBy     String
  ownerId      Int
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  // Coordinates are optional until an address-to-map lookup is added.
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  inquiries    Inquiry[]

  @@index([location])
  @@index([rent])
  @@index([ownerId])
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  listingId Int
  senderId  Int
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sender  User    @relation("InquirySender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([listingId])
  @@index([senderId])
}

// A housing request is the seeker side of the marketplace: someone describing
// the room they need, rather than a room they have available.
model HousingRequest {
  id                Int      @id @default(autoincrement())
  ownerId           Int
  title             String
  maxRent           Int
  preferredLocation String
  description       String
  moveInDate        String
  moveOutDate       String
  bedroomsNeeded    Int      @default(1)
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([preferredLocation])
  @@index([maxRent])
}
