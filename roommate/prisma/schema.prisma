generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      Int              @id @default(autoincrement())
  name                    String
  email                   String           @unique
  passwordHash            String?
  affiliationType         String?
  affiliationName         String?
  verificationStatus      String           @default("unverified")
  verificationSubmittedAt DateTime?
  createdAt               DateTime         @default(now())
  listings                Listing[]
  housingRequests         HousingRequest[]
  sentInquiries           Inquiry[]        @relation("InquirySender")
  sentLeadResponses       LeadResponse[]   @relation("LeadResponseSender")
  reportsMade             Report[]         @relation("ReportReporter")
  reportsReviewed         Report[]         @relation("ReportReviewer")
  blocksCreated           UserBlock[]      @relation("Blocker")
  blocksReceived          UserBlock[]      @relation("Blocked")
}

model Listing {
  id                Int            @id @default(autoincrement())
  title             String
  rent              Int
  location          String
  description       String
  bedrooms          Int
  bathroomType      String
  availableFrom     String
  availableUntil    String?
  roomType          String         @default("private")
  leaseType         String         @default("fixed_term")
  furnished         Boolean        @default(false)
  utilitiesIncluded Boolean        @default(false)
  utilitiesEstimate Int?
  securityDeposit   Int?
  parkingAvailable  Boolean        @default(false)
  petsAllowed       Boolean        @default(false)
  postedBy          String
  status            String         @default("active")
  ownerId           Int
  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  // Coordinates are optional until an address-to-map lookup is added.
  latitude          Float?
  longitude         Float?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  inquiries         Inquiry[]
  photos            ListingPhoto[]

  @@index([location])
  @@index([rent])
  @@index([ownerId])
}

model ListingPhoto {
  id         Int      @id @default(autoincrement())
  listingId  Int
  url        String
  storageKey String   @unique
  altText    String
  position   Int
  createdAt  DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  listingId Int
  senderId  Int
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sender  User    @relation("InquirySender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([listingId])
  @@index([senderId])
}

// A housing request is the seeker side of the marketplace: someone describing
// the room they need, rather than a room they have available.
model HousingRequest {
  id                Int      @id @default(autoincrement())
  ownerId           Int
  title             String
  maxRent           Int
  preferredLocation String
  description       String
  moveInDate        String
  moveOutDate       String
  bedroomsNeeded    Int      @default(1)
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  leadResponses LeadResponse[]

  @@index([ownerId])
  @@index([preferredLocation])
  @@index([maxRent])
}

model LeadResponse {
  id               Int            @id @default(autoincrement())
  housingRequestId Int
  senderId         Int
  message          String
  createdAt        DateTime       @default(now())
  housingRequest   HousingRequest @relation(fields: [housingRequestId], references: [id], onDelete: Cascade)
  sender           User           @relation("LeadResponseSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([housingRequestId])
  @@index([senderId])
}

// Reports preserve the original complaint and the administrator's decision.
// targetType + targetId is a deliberate polymorphic reference: the service
// validates that the target exists before creating the report.
model Report {
  id            Int       @id @default(autoincrement())
  reporterId    Int
  reviewerId    Int?
  targetType    String
  targetId      Int
  reason        String
  details       String?
  status        String    @default("pending")
  moderatorNote String?
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?

  reporter User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reviewer User? @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
